# Dependencias y entornos
node_modules/
.venv/

# Renders y pruebas (pesados, se regeneran)
**/render/*.mp4
**/muestras/
**/composicion/renders/
**/composicion/.hyperframes/artifacts/
**/.hyperframes/cache/

# Referencias de terceros (no se versionan)
referencias/**/videos/
referencias/**/analisis/**/frames/
referencias/**/analisis/**/*.wav

# Temporales del sistema
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
~$*

# Laboratorio de la biblioteca (descartable)
biblioteca/_laboratorio/

# Fotogramas de revisión (se regeneran con render.sh; la hoja de contactos sí se versiona)
**/render/*-frames/
**/render/qa/
**/composicion/.hyperframes/

# Candidatas de música (se eligen y se copian a assets/compartidos/musica/)
assets/compartidos/musica/candidatas/
assets/compartidos/sfx/candidatas/
.tmp-fabrica/

# Enlaces (junctions) a composicion/assets en cada slide/historia: se recrean con mklink /J
**/composicion-*/assets
# Mayores a 100 MB (límite de GitHub): se guardan fuera del repo
assets/synous/grabaciones/movil/mce-movil.mp4
assets/synous/grabaciones/movil/casc-movil.mp4
# Los exports finales de los carruseles sí se versionan
!**/render/*-ig.mp4
